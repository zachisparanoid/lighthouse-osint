# =============================================================================
# Lighthouse — single .env drives every service. Copy to `.env` and edit.
#   cp .env.example .env
# Generate strong secrets before any non-local use:
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#   FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# ---- Core app -------------------------------------------------------------
LIGHTHOUSE_ENV=development                 # development | production
LOG_LEVEL=INFO

# JWT signing key (access + refresh tokens). REQUIRED — app refuses to boot if unset.
SECRET_KEY=dev-only-insecure-change-me-please-0123456789abcdef0123456789abcdef
# Fernet key used to encrypt BYOK API keys at rest. REQUIRED, must be a valid Fernet key.
FERNET_KEY=5kcRYKyx1p3vkLmKPzXg0tg0ZbW4apZ1o78U4V2urFo=

ACCESS_TOKEN_TTL_SECONDS=900               # 15 min, short-lived access JWT
REFRESH_TOKEN_TTL_SECONDS=1209600          # 14 days, rotating refresh cookie
TOTP_ISSUER=Lighthouse

# Comma-separated CORS origins for the API (the Next.js app origin).
ALLOWED_ORIGINS=http://localhost:3000

# ---- Auth hardening -------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5                        # lock account after N failures
LOGIN_LOCKOUT_SECONDS=900                   # 15 min lockout window

# Optional first-run admin bootstrap (created on API startup if no users exist).
# NOTE: use a real TLD — reserved/special-use domains (.local, .test, .example, .invalid)
# are rejected by email validation and could never log in. Change before any real use.
BOOTSTRAP_ADMIN_EMAIL=admin@yourorg.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2024

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=lighthouse
POSTGRES_PASSWORD=lighthouse
POSTGRES_DB=lighthouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy URL (used by API + worker). Host=postgres inside compose network.
DATABASE_URL=postgresql+asyncpg://lighthouse:lighthouse@postgres:5432/lighthouse
# Sync URL for Alembic migrations.
SYNC_DATABASE_URL=postgresql+psycopg://lighthouse:lighthouse@postgres:5432/lighthouse

# ---- Redis (cache + rate-limit buckets + Celery broker/result) ------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Collection engine ----------------------------------------------------
# Sent on every outbound request so sources can identify and contact us (good citizenship).
HTTP_USER_AGENT=LighthouseOSINT/1.0 (+https://github.com/your-org/lighthouse; research use)
REQUEST_TIMEOUT_SECONDS=20
DEFAULT_AUTOEXPAND_DEPTH=2
DEFAULT_NODE_BUDGET=250
# Comma-separated hosts/domains/CIDRs the ScopeGuard always refuses (in addition to RFC1918 etc.).
SCOPE_DENYLIST=localhost,127.0.0.1,*.gov,*.mil
# Circuit breaker: open after N consecutive failures per service, cool down for M seconds.
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# ---- Optional global fallback API keys ------------------------------------
# BYOK is the primary mechanism (per-user/per-case, encrypted in DB). These optional
# env values act as a fallback so keyed collectors can run without per-user setup.
# Leave blank to force BYOK-only. Keyed collectors degrade gracefully when absent.
SHODAN_API_KEY=
HIBP_API_KEY=
OPENCORPORATES_API_KEY=

# ---- Reports --------------------------------------------------------------
REPORTS_DIR=/data/reports

# Host ports the services are published on (change if 8000/3000 are taken on your host).
# If you change API_HOST_PORT, also update NEXT_PUBLIC_WS_URL below to match.
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# ---- Frontend (Next.js) ---------------------------------------------------
# Public (browser-exposed) URLs for the API and WebSocket endpoint.
# REST is proxied same-origin via Next (/api -> INTERNAL_API_URL), so NEXT_PUBLIC_API_URL
# is informational; NEXT_PUBLIC_WS_URL must point at the published API port (API_HOST_PORT).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Server-side URL the Next.js server uses to reach the API inside the compose network.
INTERNAL_API_URL=http://api:8000
