{
  "name": "lighthouse",
  "version": "1.0.0",
  "private": true,
  "description": "Lighthouse — a self-hostable, ethically-scoped OSINT investigation platform.",
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "gen:types": "node packages/shared-types/scripts/generate.mjs",
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run gen:types && npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web"
  },
  "engines": {
    "node": ">=18.18"
  }
}
